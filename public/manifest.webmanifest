{
  "id": "/",
  "name": "MKU Pulse — Campus Social",
  "short_name": "MKU Pulse",
  "description": "Connect with your Mount Kenya University community: share campus updates, meet students, find mentors and chat in real time.",
  "lang": "en-KE",
  "dir": "ltr",
  "start_url": "/feed",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f4faff",
  "theme_color": "#3f83bd",
  "categories": ["social", "education", "lifestyle"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Campus Feed",
      "short_name": "Feed",
      "description": "See updates from your campus community.",
      "url": "/feed",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Connect with Students",
      "short_name": "Connect",
      "description": "Discover and connect with other students.",
      "url": "/connect",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "Open your campus conversations.",
      "url": "/messages",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mku-pulse-wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "MKU Pulse campus home on a desktop screen"
    },
    {
      "src": "/screenshots/mku-pulse-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MKU Pulse campus home on a mobile screen"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
