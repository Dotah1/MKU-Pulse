# Public Supabase client configuration
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Firebase Admin configuration
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Public app origin and scheduled cleanup
PUBLIC_APP_URL=https://mku-pulse.vercel.app
PURGE_EXPIRED_POSTS_SECRET=
CRON_SECRET=

# Optional Cloudflare Worker URL, shared by client uploads/reads and server-side deletion.
# Leave blank to use Supabase Storage for new media.
VITE_R2_MEDIA_WORKER_URL=

# Server-only shared secret: configure the same random value in Vercel and as the
# R2_MEDIA_CLEANUP_SECRET secret binding on the mku-pulse-media Worker.
R2_MEDIA_CLEANUP_SECRET=
